# Auto detect text files and perform LF normalization
* text=auto

# Only track essential maps with LFS
*.umap filter=lfs diff=lfs merge=lfs -text
# Only track essential uassets with LFS (exclude third-party)
Content/BluePrints/**/*.uasset filter=lfs diff=lfs merge=lfs -text
Content/Characters/**/*.uasset filter=lfs diff=lfs merge=lfs -text
Content/Maps/**/*.uasset filter=lfs diff=lfs merge=lfs -text
# Keep other LFS patterns for engine files
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.upk filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
