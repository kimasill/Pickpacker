# Auto detect text files and perform LF normalization
* text=auto
# Treat common UE text formats as text
*.ini text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.uprojectdirs text eol=lf
*.cs text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.mm text eol=lf
*.m text eol=lf
*.py text eol=lf
*.json text eol=lf
# Track UE assets with LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.udic filter=lfs diff=lfs merge=lfs -text
*.ufont filter=lfs diff=lfs merge=lfs -text
*.upack filter=lfs diff=lfs merge=lfs -text
*.utexture filter=lfs diff=lfs merge=lfs -text
*.dds filter=lfs diff=lfs merge=lfs -text
# Track common media with LFS
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
# Track art/source binaries with LFS
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.pak filter=lfs diff=lfs merge=lfs -text
*.ucas filter=lfs diff=lfs merge=lfs -text
*.utoc filter=lfs diff=lfs merge=lfs -text
# Ignore diffs for binary files
*.uasset -diff
*.umap -diff
*.fbx -diff
*.psd -diff
*.png -diff
*.jpg -diff
*.tga -diff
# Keep pointer-size consistency on Windows binaries
*.dll -text
*.lib -text
*.exe -text
Content/Maps/*.umap filter=lfs diff=lfs merge=lfs -text
Content/Maps/**/*.umap filter=lfs diff=lfs merge=lfs -text
Content/__ExternalActors__/Maps/**/*.uasset filter=lfs diff=lfs merge=lfs -text
