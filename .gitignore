# =========================
# UNREAL ENGINE SPECIFIC
# =========================

# Binary Files (Always ignore)
Binaries/*
Plugins/*/Binaries/*

# Built data for maps
*_BuiltData.uasset

# Compiled source files
Intermediate/*
Plugins/*/Intermediate/*

# Cache files
DerivedDataCache/*

# Configuration files generated by the Editor
Saved/*

# Packaged builds
Build/*
Dist/*
Packaged/*
WindowsNoEditor/*
LinuxNoEditor/*
MacNoEditor/*
AndroidNoEditor/*
IOSNoEditor/*

# Whitelist specific build files if needed
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Starter Content (Usually large and not needed in version control)
**/Geometry
**/Mannequin
**/Mannequins
**/Mannequin_UE4
**/ThirdPerson
**/ThirdPersonBP
**/LearningKit_Games
**/MilitaryWeapSilver
**/StarterContent

# Third Party Content (Add specific folders as needed)
Content/Assets/FPS_Weapon_Bundle/*
Content/Assets/ParagonWraith/*
Content/Assets/LearningKit_Games/*
Content/Assets/sA_PickupSet_1/*
Content/Assets/Interface_And_Item_Sounds/*
Content/Assets/Weapon_Pack/*

# Large Asset folders - Exclude to reduce LFS usage
Content/Assets/Animations/*
Content/Assets/Sounds/*
Content/Assets/Textures/Crosshairs/*
Content/Assets/Textures/Grenades/*
Content/Assets/Textures/Overlay/*

# Allow only essential project assets
!Content/Assets/Materials/MI_*.uasset
!Content/Assets/Materials/M_DissolveEffect.uasset
!Content/Assets/Materials/PP_Highlight.uasset
!Content/Assets/Fonts/*
!Content/Assets/Curves/*
!Content/Assets/FX/SniperScope/*

# All References folder content (mostly third-party examples)
**/References/*
**/Characters/*


# External Actors/Objects (Can be very large)
Content/__ExternalActors__/*
Content/__ExternalObjects__/*

# Developer-specific content
Content/Developers/*

# Collections
Content/Collections/*

# =========================
# GENERAL FILES
# =========================

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Engine files
**/EngineData/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Windows files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Backup files
*.bak
*.backup
*_backup.*
*.uasset.bak
*.tmp
*.temp
*~

# Log files
*.log
Logs/*

# Asset Data (Custom game assets that might be large)
GameAssets/*

# Crash dumps
*.dmp
Saved/Crashes/*

# Auto-generated screenshots
Saved/Screenshots/*
AutoScreenshot.png

# Cooked content
Saved/Cooked/*

# Shader cache
Saved/Shaders/*
Saved/ShaderDebugInfo/*

# Material stats
Saved/MaterialStats/*
Saved/MaterialStatsDebug/*

# Temp files
Temp.txt
*.temp
