*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.sln.DotSettings.user
*.csproj.user

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# Generated project files
*.xcodeproj
*.xcworkspace
*.sln
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# =========================
# UNREAL ENGINE SPECIFIC
# =========================

# Binary Files (Always ignore)
Binaries/*
Plugins/*/Binaries/*

# Built data for maps
*_BuiltData.uasset

# Compiled source files
Intermediate/*
Plugins/*/Intermediate/*

# Cache files
DerivedDataCache/*

# Configuration files generated by the Editor
Saved/*

# Packaged builds
Build/*
Dist/*
Packaged/*
WindowsNoEditor/*
LinuxNoEditor/*
MacNoEditor/*
AndroidNoEditor/*
IOSNoEditor/*

# Whitelist specific build files if needed
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Optional large content you may want to exclude (adjust as needed)
Content/__ExternalActors__/**
Content/__ExternalObjects__/**
Content/Developers/*
Content/Collections/*
Content/References/**

# OS junk
.DS_Store
Thumbs.db

# Logs and dumps
*.log
Logs/*
*.dmp

# Temp files
*.tmp
*.temp
*~

# Shader and cooked caches
Saved/Cooked/*
Saved/Shaders/*
Saved/ShaderDebugInfo/*
Saved/MaterialStats/*
Saved/MaterialStatsDebug/*

# Keep only source & config implicitly (no need to force unignore). We will explicitly re-include plugin descriptors & plugin source below.

# Ignore entire Plugins tree first, then re-include parent dirs + .uplugin + Source + Config inside each plugin.
Plugins/**
!Plugins/
!Plugins/*/
!Plugins/*/*.uplugin
!Plugins/*/Source/
!Plugins/*/Source/**
!Plugins/*/Config/
!Plugins/*/Config/**

# Exclude all UE Content (publish branch: no assets)
Content/**

# Exclude heavy plugin content (kept external)
# PCG Dungeon generator plugin content is large; keep plugin source but exclude assets.
Plugins/PCGDungeonGenerator/**/Content/**

# Optional: exclude StarterContent (can be re-added via UE content packs)
Content/StarterContent/**

# Documentation: ignore bulk markdown but keep the main README for context.
*.md
!README.md

# Drop plugin docs from publish snapshot
Plugins/**/README.md
Plugins/**/Docs/**

# Re-ignore stray editor/backup files that were force-unignored previously.
Source/**/*~

# Avoid adding binary/art assets to keep LFS usage near-zero in publish branch
*.png
*.jpg
*.jpeg
*.tga
*.bmp
*.psd
*.exr
*.hdr
*.fbx
*.FBX
*.wav
*.mp3
*.ogg
*.uasset
*.umap

# Additional heavy content exclusions to reduce LFS footprint
# Textures and large reference content can be re-sourced or packed separately
Content/Textures/**
# Project demo/reference maps are bulky; exclude maps from VCS (keep in external storage)
Content/Maps/**
# Exclude reference asset packs inside Assets
Content/Assets/Ref/**

# Exclude plugin content assets (keep only plugin source/build scripts)
Plugins/**/Content/**

# Exclude cinematic sequences and takes
Content/Sequences/**

# Exclude large plugins as requested
Plugins/DLSS/
Plugins/StreamlineNGXCommon/
Plugins/XeSS_5.6/

# Other files
steam_appid.txt

# IDE / Editor settings
.cursor/

# Stray asset export (should not be in VCS)
DA_ParcelData.T3D

