# =========================
# UNREAL ENGINE SPECIFIC
# =========================

# Binary Files (Always ignore)
Binaries/*
Plugins/*/Binaries/*

# Built data for maps
*_BuiltData.uasset

# Compiled source files
Intermediate/*
Plugins/*/Intermediate/*

# Cache files
DerivedDataCache/*

# Configuration files generated by the Editor
Saved/*

# Packaged builds
Build/*
Dist/*
Packaged/*
WindowsNoEditor/*
LinuxNoEditor/*
MacNoEditor/*
AndroidNoEditor/*
IOSNoEditor/*

# Whitelist specific build files if needed
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Optional large content you may want to exclude (adjust as needed)
Content/__ExternalActors__/*
Content/__ExternalObjects__/*
Content/Developers/*
Content/Collections/*

# OS junk
.DS_Store
Thumbs.db

# Logs and dumps
*.log
Logs/*
*.dmp

# Temp files
*.tmp
*.temp
*~

# Shader and cooked caches
Saved/Cooked/*
Saved/Shaders/*
Saved/ShaderDebugInfo/*
Saved/MaterialStats/*
Saved/MaterialStatsDebug/*

# Keep source, config, content, and plugin sources
!Source/**
!Config/**
!Content/**
!Plugins/**
