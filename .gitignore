# =========================
# UNREAL ENGINE 5 GITIGNORE
# =========================
Binaries
DerivedDataCache
Intermediate
Saved
Build

# Misplaced VS-created folder (avoid accidental include)
C++ Source/**

# Visual Studio IDE files
.vs/
.vscode/
.idea/
.vscode
.vs
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace
